# ---------------------------------------------------------------- data
# Generated by `python src/generate_burnin_dataset.py` (seed 42, reproducible).
# Never commit it: it is regenerable in seconds and it bloats diffs.
data/*
!data/.gitkeep

# model artefacts + generated reports. Anchored to the root: an unanchored
# `models/` also swallowed backend/app/models/, the ORM package the API imports.
/models/
/artifacts/
/reports/
*.pkl
*.joblib
*.onnx

# ---------------------------------------------------------------- python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# environments
.venv/
venv/
env/
ENV/

# tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# notebooks
.ipynb_checkpoints/

# streamlit
.streamlit/secrets.toml

# ---------------------------------------------------------------- editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- local secrets
.env
.env.*
!.env.example

# web/ build output
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts
web/*.tsbuildinfo

# Runtime state: SQLite database, uploaded datasets, model artifacts.
# Regenerable with `python -m backend.train`; never a source of truth.
var/
